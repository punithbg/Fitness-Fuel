{
  "name": "fitness",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:cloud": "firebase emulators:exec --config firebase.emulators.json --project demo-form-and-fuel --only firestore \"vitest run src/data/cloud/CloudRepository.emulator.test.ts\"",
    "test:cloud:e2e": "firebase emulators:exec --config firebase.emulators.json --project demo-form-and-fuel --only auth,firestore \"playwright test --config playwright.cloud.config.ts\"",
    "format": "prettier --write src tests public/data *.ts index.html package.json README.md",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "@hookform/resolvers": "^7.0.1",
    "@noble/hashes": "^2.4.0",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "firebase": "12.0.0",
    "lucide-react": "^1.66.0",
    "mimetext": "^3.0.28",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.0",
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.7",
    "firebase-tools": "^15.35.0",
    "jsdom": "^29.1.1",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
